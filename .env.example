# Network: bsc-testnet (default) | bsc-mainnet
NETWORK=bsc-testnet

# BNB Agent SDK wallet (EVMWalletProvider)
WALLET_PASSWORD=change-me
PRIVATE_KEY=

# ERC-8183: public base URL for the seller agent's deliverable fallback
ERC8183_AGENT_URL=https://your-agent.example.com

# ERC-8183 client flow: address of the agent you are hiring
PROVIDER_ADDRESS=

# 8004scan developer API key (backend only, never in the browser)
SCAN_8004_API_KEY=
