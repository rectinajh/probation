# Network: bsc-testnet (default) | bsc-mainnet (chain id 97, token tBNB on testnet)
NETWORK=bsc-testnet
# Optional: point the SDK at a custom ERC-8183 deployment. Our demo stack uses
# a 9s dispute window (official bsc-testnet is 900s). Omit these to use the
# SDK's default bsc-testnet contracts.
ERC8183_COMMERCE_ADDRESS=0x30b60a735e2df8a2909b0cfecfcf338a90bde013
ERC8183_ROUTER_ADDRESS=0x251b90f07d270d3a435eac6bb7a4b0f7cab76124
ERC8183_POLICY_ADDRESS=0x45e04b6be81cce7208bf5518ca64f47b82c1057d

# Agent/seller wallet password: encrypts the local Keystore V3 file. You invent
# it. Keep it secret. See docs/ENV.md. (Do NOT put a real password here — this
# file is committed to git. Put real values in .env.)
WALLET_PASSWORD=change-me
# Agent/seller wallet private key: first-run only (imported, then encrypted to
# ~/.bnbagent/wallets/<addr>.json). Fund this wallet with test BNB from the BNB
# Chain faucet. See docs/ENV.md. (Do NOT put a real key here — committed file.)
PRIVATE_KEY=

# Public base URL of your seller-runner (deliverable fallback host). Dev: use a
# tunnel (ngrok/cloudflared). Judging: your deployed orchestrator URL.
ERC8183_AGENT_URL=https://your-agent.example.com

# Address of the agent you are hiring (the seller/agent wallet, ERC-8004). For a
# self-hire demo it is your registered agent address.
PROVIDER_ADDRESS=

# 8004scan developer API key (backend only). Create at 8004scan.io/developers;
# hackathon participants apply for free Pro-tier via the Pro-Tier Upgrade Form.
# (Do NOT put a real key here — committed file. Put real values in .env.)
SCAN_8004_API_KEY=
